{
    "version": "8.9.8.1",
    "description": "A free source code editor and Notepad replacement that supports several languages.",
    "homepage": "https://notepad-plus-plus.org/",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/notepad-plus-plus/notepad-plus-plus/releases/download/v8.9.8.1/npp.8.9.8.1.portable.x64.zip",
            "hash": "beddf5548e75c97930d1575ba1c7d113e6e2b33d0a200310e734ca08e225f414"
        },
        "arm64": {
            "url": "https://github.com/notepad-plus-plus/notepad-plus-plus/releases/download/v8.9.8.1/npp.8.9.8.1.portable.arm64.zip",
            "hash": "43bf78c7569fd43b03d4f86a1073ac4306b31099e4487bdbf536c42d16d03f48"
        }
    },
    "pre_install": [
        "Copy-Item \"$dir\\langs.model.xml\" \"$dir\\langs.xml\"",
        "'config.xml', 'contextMenu.xml', 'nativeLang.xml', 'session.xml', 'session.xml.inCaseOfCorruption.bak', 'shortcuts.xml' | ForEach-Object {",
        "    if (!(Test-Path \"$persist_dir\\$_\")) { New-Item \"$dir\\$_\" -ItemType File | Out-Null }",
        "}",
        "if (!(Test-Path \"$persist_dir\\stylers.xml\")) {",
        "    Copy-Item \"$dir\\stylers.model.xml\" \"$dir\\stylers.xml\"",
        "}"
    ],
    "bin": "notepad++.exe",
    "shortcuts": [
        [
            "notepad++.exe",
            "Notepad++"
        ]
    ],
    "persist": [
        "backup",
        "plugins",
        "userDefineLangs",
        "config.xml",
        "contextMenu.xml",
        "nativeLang.xml",
        "session.xml",
        "session.xml.inCaseOfCorruption.bak",
        "shortcuts.xml",
        "stylers.xml"
    ],
    "post_install": [
        "# Update shipped plugins",
        "if (Test-Path \"$dir\\plugins.original\") {",
        "    Copy-Item \"$dir\\plugins.original\\*\" \"$dir\\plugins\\\" -Recurse -Force",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/notepad-plus-plus/notepad-plus-plus"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/notepad-plus-plus/notepad-plus-plus/releases/download/v$version/npp.$version.portable.x64.zip"
            },
            "arm64": {
                "url": "https://github.com/notepad-plus-plus/notepad-plus-plus/releases/download/v$version/npp.$version.portable.arm64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/npp.$version.checksums.sha256"
        }
    }
}
